<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Daggerheart - Scheda Personaggio</title>
    
    <!-- Librerie React e Tailwind -->
    <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">

    <style>
        :root { 
            --bg-dark: #121212; 
            --bg-panel: #1e1e1e; 
            --border-color: #3f3f46; 
            --gold: #ca8a04; 
            --red: #991b1b; 
            --text-main: #e4e4e7; 
        }

        body { 
            font-family: 'Lato', sans-serif; 
            background-color: var(--bg-dark); 
            color: var(--text-main); 
            overscroll-behavior-y: none; 
            user-select: none; 
        }

        h1, h2, h3, .font-cinzel { font-family: 'Cinzel', serif; }
        
        /* Utility Classes */
        .pip-container { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }
        .pip { width: 18px; height: 18px; border-radius: 50%; border: 2px solid #525252; background: transparent; transition: all 0.2s ease; cursor: pointer; }
        .pip.active { background-color: var(--text-main); border-color: var(--text-main); box-shadow: 0 0 4px rgba(255,255,255,0.5); }
        .pip.hp.active { background-color: #ef4444; border-color: #ef4444; box-shadow: 0 0 6px #ef4444; }
        .pip.stress.active { background-color: #d8b4fe; border-color: #d8b4fe; box-shadow: 0 0 6px #d8b4fe; }
        .pip.hope.active { background-color: #facc15; border-color: #facc15; box-shadow: 0 0 6px #facc15; }
        .pip.armor.active { background-color: #60a5fa; border-color: #60a5fa; box-shadow: 0 0 6px #60a5fa; }
        .pip.gold-chest.active { background-color: #fbbf24; border-color: #fbbf24; box-shadow: 0 0 8px #fbbf24; }
        .pip.gold.active { background-color: #fbbf24; border-color: #fbbf24; }
        .pip.proficiency.active { background-color: #10b981; border-color: #10b981; box-shadow: 0 0 6px #10b981; }

        .dh-panel { background-color: var(--bg-panel); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px; margin-bottom: 12px; position: relative; }
        .dh-input { background: #27272a; border: 1px solid #3f3f46; color: white; padding: 8px; border-radius: 4px; width: 100%; font-size: 1rem; transition: all 0.2s; }
        .dh-input.read-only { background: transparent; border: 1px solid transparent; padding: 0; color: var(--gold); font-weight: bold; pointer-events: none; }
        .dh-input.read-only.text-white-override { color: white; } 
        .dh-input:focus { outline: none; border-color: var(--gold); }
        
        select.dh-input { 
            -webkit-appearance: none; 
            -moz-appearance: none;
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e"); 
            background-repeat: no-repeat; 
            background-position: right 0.5rem center; 
            background-size: 1em; 
            padding-right: 2rem; 
        }
        select.dh-input.read-only { 
            background-image: none; 
            padding-right: 0; 
            appearance: none; 
        }
        
        option {
            background-color: #1e1e1e;
            color: #e4e4e7;
        }

        .stat-box { display: flex; flex-direction: column; align-items: center; background: #27272a; border: 1px solid #3f3f46; border-radius: 6px; padding: 8px 4px; cursor: pointer; position: relative; transition: border-color 0.2s; }
        .stat-val-display { font-family: 'Cinzel', serif; font-weight: 700; font-size: 1.5rem; text-align: center; width: 40px; }
        .stat-arrow { color: #71717a; padding: 2px 8px; cursor: pointer; font-size: 0.8rem; user-select: none; }
        
        .char-portrait-container { 
            position: relative; 
            width: 210px; 
            height: 210px; 
            margin: 0 auto 16px auto; 
        }
        
        .char-portrait { 
            width: 100%; 
            height: 100%; 
            border: 3px solid var(--gold); 
            object-fit: cover; 
            display: block; 
            background: #27272a; 
            cursor: pointer; 
            border-radius: 4px; 
        }
        
        .level-rank-container {
            position: absolute;
            top: 20px;
            right: -70px;
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 60px;
            z-index: 10;
            cursor: pointer;
            transition: transform 0.2s;
        }
        .level-rank-container:active { transform: scale(0.95); }

        .level-badge-circle {
            width: 50px;
            height: 50px;
            background-color: #1e1e1e;
            border: 2px solid var(--gold);
            border-radius: 50%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--gold);
            font-family: 'Cinzel', serif;
            box-shadow: 0 4px 10px rgba(0,0,0,0.8);
            margin-bottom: 4px;
            transition: all 0.2s;
        }
        .level-badge-circle:hover {
            box-shadow: 0 0 15px rgba(202, 138, 4, 0.4);
            border-color: #fde047;
        }

        .rank-text {
            font-family: 'Cinzel', serif;
            font-size: 0.7rem;
            color: #ca8a04;
            font-weight: bold;
            text-transform: uppercase;
            text-shadow: 0 1px 2px black;
            text-align: center;
            width: 100%;
        }
        
        .editing .dh-input { border-color: #525252; background: #27272a; pointer-events: auto; }
        .playing .dh-input { border-color: transparent; background: transparent; pointer-events: none; }
        
        /* Force interactivity for local-editing elements even in playing mode */
        .playing .local-editing .dh-input,
        .playing .local-editing select, 
        .playing .local-editing textarea { 
            pointer-events: auto !important; 
            border-color: #3f3f46 !important; 
            background: #27272a !important; 
        }

        .playing .edit-only { display: none !important; }
        
        .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.9); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 20px; backdrop-filter: blur(4px); }
        .dice-result { font-family: 'Cinzel', serif; animation: popIn 0.3s ease-out; }
        
        @keyframes popIn { 0% { transform: scale(0.5); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
        @keyframes resultPulse { 0% { transform: scale(1); } 50% { transform: scale(1.02); box-shadow: 0 0 20px rgba(255,255,255,0.2); } 100% { transform: scale(1); } }
        
        .result-box-large {
            padding: 16px;
            width: 100%;
            text-align: center;
            border-radius: 8px;
            font-family: 'Cinzel', serif;
            font-weight: 700;
            font-size: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-top: 10px;
            animation: resultPulse 2s infinite ease-in-out;
            border-width: 2px;
        }

        .mode-btn { flex: 1; padding: 8px; text-align: center; font-size: 0.75rem; font-weight: bold; text-transform: uppercase; cursor: pointer; border: 1px solid #3f3f46; transition: all 0.2s; }
        .mode-btn:first-child { border-radius: 6px 0 0 6px; }
        .mode-btn:last-child { border-radius: 0 6px 6px 0; }
        .mode-btn.active-normal { background-color: #3f3f46; color: white; border-color: #52525b; }
        .mode-btn.active-adv { background-color: #15803d; color: white; border-color: #16a34a; }
        .mode-btn.active-dis { background-color: #b91c1c; color: white; border-color: #dc2626; }

        .die-box { width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; font-family: 'Cinzel', serif; font-size: 2.5rem; font-weight: bold; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.3); }
        .die-hope { background-color: #f3f4f6; color: #000; border: 3px solid #d1d5db; }
        .die-fear { background-color: #111827; color: #fff; border: 3px solid #374151; }
        
        .weapon-swap-btn {
            background-color: #27272a; border: 1px solid #3f3f46; color: #ca8a04;
            text-transform: uppercase; font-size: 0.7rem; padding: 4px 8px;
            border-radius: 4px; font-weight: bold; cursor: pointer;
            margin-top: 8px; width: 100%; transition: all 0.2s;
        }
        .weapon-swap-btn:hover { background-color: #3f3f46; color: white; }

        .short-rest-btn {
            background-color: #27272a; border: 1px solid #3f3f46; color: #a1a1aa;
            padding: 8px; border-radius: 6px; text-align: center; cursor: pointer;
            transition: all 0.2s; border-left: 4px solid transparent;
        }
        .short-rest-btn.selected { background-color: #3f3f46; color: white; border-color: var(--gold); border-left-color: var(--gold); }
        .short-rest-btn:hover { background-color: #3f3f46; }
        .short-rest-btn:disabled { opacity: 0.5; cursor: not-allowed; hover: none; border-color: #3f3f46; color: #52525b; }
        
        @keyframes pulse-gold-btn { 
            0% { box-shadow: 0 0 0 0 rgba(202, 138, 4, 0.7); transform: scale(1); } 
            50% { box-shadow: 0 0 10px 4px rgba(202, 138, 4, 0.5); transform: scale(1.02); } 
            100% { box-shadow: 0 0 0 0 rgba(202, 138, 4, 0); transform: scale(1); } 
        }
        .crit-btn { 
            animation: pulse-gold-btn 1.5s infinite !important; 
            background-color: #ca8a04 !important; 
            color: black !important; 
            border: 2px solid white !important; 
            font-weight: 800 !important;
        }

        /* --- STILI SPECIFICI PER MODALITÀ MODIFICA (BIANCO) --- */
        .editing .text-\[\#ca8a04\], 
        .editing .text-red-400, 
        .editing .text-red-500,
        .editing .text-blue-400, 
        .editing .text-blue-500,
        .editing .text-purple-400, 
        .editing .text-purple-500,
        .editing .text-yellow-400,
        .editing .text-emerald-400,
        .editing h1:not(.header-title), 
        .editing h2, 
        .editing h3, 
        .editing h4, 
        .editing label {
            color: white !important;
        }

        /* Titolo Principale in Modifica rimane Oro */
        .header-title {
            color: #ca8a04 !important;
        }

        /* Bordi Bianchi in Modifica */
        .editing [class*="border-[#ca8a04]"],
        .editing [class*="border-red-"],
        .editing [class*="border-blue-"],
        .editing [class*="border-gray-"],
        .editing [class*="border-yellow-"],
        .editing .char-portrait,
        .editing .level-badge-circle,
        .editing .dh-panel {
            border-color: white !important;
        }
        
        /* Livello e Rango in Modifica: Bordo e Testo Bianco */
        .editing .level-badge-circle {
            border-color: white !important;
            color: white !important;
        }
        .editing .rank-text {
            color: white !important;
        }

        /* Pip Bianchi in Modifica */
        .editing .pip.active {
            background-color: white !important;
            border-color: white !important;
            box-shadow: 0 0 4px white !important;
        }
        
        /* Input valori numerici (statistiche) in Modifica */
        .editing input.text-yellow-400,
        .editing input.text-emerald-400 {
            color: white !important;
        }
        
        /* Scritta Forgia in bianco in modalità modifica */
        .editing .forge-submit-btn {
            color: white !important;
        }

         /* 3D Transform Classes */
        .transform-style-3d {
            transform-style: preserve-3d;
        }
        .perspective-1000 {
            perspective: 1000px;
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef, useMemo } = React;

        // --- ICONS ---
        const IconHome = () => (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        );
        const IconLockClosed = () => (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        );
        const IconLockOpen = () => (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>
        );
        const IconArrowLeft = () => (
             <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        );
        const IconArrowRight = () => (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        );
        const IconPlus = () => (
             <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        );
        const IconTrash = () => (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
        );

        // --- COSTANTI ---
        const TRAITS = { agility: "Agilità", strength: "Forza", finesse: "Finezza", instinct: "Istinto", presence: "Presenza", knowledge: "Conoscenza" };
        const TRAIT_SKILLS = {
            agility: "Scatto, Balzo, Manovra", strength: "Sollevare, Fracassare, Lottare", finesse: "Controllare, Nascondersi, Armeggiare",
            instinct: "Percepire, Intuire, Orientarsi", presence: "Affascinare, Esibirsi, Ingannare", knowledge: "Rammentare, Analizzare, Compr."
        };
        const DICE = ["d4", "d6", "d8", "d10", "d12", "d20"];
        
        // Liste Opzioni
        const HERITAGE_LIST = [
            "Clank", "Drakona", "Dwarf", "Elf", "Faerie", "Faun", "Firbolg", 
            "Fungril", "Galapa", "Giant", "Goblin", "Halfling", "Human", 
            "Infernis", "Katari", "Orc", "Ribbet", "Simiah"
        ];
        
        const COMMUNITY_LIST = [
            "Highborne", "Loreborne", "Orderborne", "Ridgeborne", 
            "Seaborne", "Slyborne", "Underborne", "Wanderborne", "Wildborne"
        ];

        const POTION_TYPES = [
            { id: "hp", label: "Punti Ferita", color: "text-red-500" },
            { id: "stress", label: "Stress", color: "text-purple-500" },
            { id: "hope", label: "Speranza", color: "text-yellow-400" }
        ];

        const CLASS_CONFIG = {
            "Druido": { spellcast: "Istinto", domains: ["Saggio", "Arcano"], subclasses: ["Warden of the Elements", "Warden of Renewal"] },
            "Bardo": { spellcast: "Presenza", domains: ["Grazia", "Codice"], subclasses: ["Troubadour", "Wordsmith"] },
            "Guardiano": { spellcast: "-", domains: ["Valore", "Lama"], subclasses: ["Stalwart", "Vengeance"] },
            "Guerriero": { spellcast: "-", domains: ["Lama", "Ossa"], subclasses: ["Call of the Slayer", "Call of the Brave"] },
            "Ladro": { spellcast: "Finezza", domains: ["Tenebra", "Grazia"], subclasses: ["Nightwalker", "Syndicate"] },
            "Mago": { spellcast: "Conoscenza", domains: ["Codice", "Splendore"], subclasses: ["School of Knowledge", "School of War"] },
            "Ranger": { spellcast: "Agilità", domains: ["Ossa", "Saggio"], subclasses: ["Beastbound", "Wayfinder"] },
            "Serafino": { spellcast: "Forza", domains: ["Splendore", "Valore"], subclasses: ["Winged Sentinel", "Divine Wielder"] }
        };
        
        const DOMAINS_LIST = ["Arcana", "Blade", "Bone", "Codex", "Grace", "Midnight", "Sage", "Splendor", "Valor"];

        const CLASSES_LIST = Object.keys(CLASS_CONFIG);
        const DEFAULT_WEAPON = { id: 0, name: "", trait: "agility", range: "Mischia", grip: "Una mano", activeSlot: "none", damageRows: [{ count: 1, die: "d8", mod: 0, mod2: 0, type: "fis" }], ammo: "" };

        const DEFAULT_CHAR = {
            name: "Eroe", playerName: "", 
            classes: [{ name: "", subclass: "", level: 1 }], 
            heritage: "", community: "", proficiency: 1, charImg: null,
            traits: { agility: 0, strength: 0, finesse: 0, instinct: 0, presence: 0, knowledge: 0 },
            evasion: 10, armorScore: 0,
            activeArmor: { name: "Armatura Base", baseThresholds: "5 / 10 / 15", baseScore: 1, traits: "Leggera", feature: "" },
            thresholds: { minor: 6, major: 12 },
            hp: { current: 0, max: 6 }, stress: { current: 0, max: 6 }, hope: { current: 2, max: 6, specialAbility: { text: "", cost: 1 } }, armorSlots: { current: 0, max: 6 },
            experiences: Array(5).fill({ text: "", mod: 0, cost: 1 }),
            gold: { handfuls: 0, bags: 0, chests: 0 },
            classFeature: "", deck: [], 
            weapons: [], 
            potions: [],
            inventory: "", potions: [], notes: "",
            proficiency: { current: 1, max: 6 }
        };

        const DEFAULT_CARDS = {
            heritages: [],
            communities: [],
            classes: [],
            subclasses: {}, 
            domains: {}
        };

        const getRank = (level) => {
            return 1; 
        };

        const compressImage = (file) => new Promise((resolve) => {
            const reader = new FileReader(); reader.readAsDataURL(file);
            reader.onload = (e) => {
                const img = new Image(); img.src = e.target.result;
                img.onload = () => {
                    const cvs = document.createElement('canvas');
                    const scale = 500 / img.width; cvs.width = 500; cvs.height = img.height * scale;
                    cvs.getContext('2d').drawImage(img, 0, 0, cvs.width, cvs.height);
                    resolve(cvs.toDataURL('image/jpeg', 0.7));
                };
            };
        });

        // --- UTILITY COMPONENTS ---

        const PipTracker = ({ total, current, onChange, type }) => {
            const safeTotal = Math.max(0, parseInt(total) || 0);
            return (
                <div className="pip-container">
                    {[...Array(safeTotal)].map((_, i) => (
                        <div key={i} onClick={() => onChange && onChange((i === 0 && current === 1) ? 0 : (i + 1 === current ? current - 1 : i + 1))} 
                             className={`pip ${type} ${i < current ? 'active' : ''}`}></div>
                    ))}
                </div>
            );
        };

        const StatBox = ({ label, value, skillText, statKey, onClick, onChange, isEditMode }) => (
            <div className={`stat-box ${!isEditMode ? 'hover:border-[#ca8a04]' : ''}`} onClick={onClick}>
                <span className="text-[10px] uppercase text-gray-500 font-bold tracking-wider mb-1">{label}</span>
                <div className="flex items-center justify-center w-full gap-2">
                    {isEditMode && <div onClick={(e)=>{e.stopPropagation(); if(value>-10) onChange(statKey, parseInt(value)-1)}} className="stat-arrow text-2xl">▼</div>}
                    <div className={`stat-val-display ${!isEditMode ? 'text-[#ca8a04]' : 'text-white'}`}>{value}</div>
                    {isEditMode && <div onClick={(e)=>{e.stopPropagation(); if(value<10) onChange(statKey, parseInt(value)+1)}} className="stat-arrow text-2xl">▲</div>}
                </div>
                <span className="text-[9px] text-center text-gray-500 leading-tight mt-1 px-1">{skillText}</span>
            </div>
        );

        const ExperienceRow = ({ exp, index, onUpdate, isEditMode }) => {
            const update = (field, val) => { const n = {...exp, [field]: val}; onUpdate(n); };
            return (
                <div className="flex items-center gap-2 mb-2 bg-[#27272a] p-1 rounded border border-[#3f3f46]">
                    <input value={exp.text} onChange={(e) => update('text', e.target.value)} 
                           className={`bg-transparent text-sm text-gray-200 flex-1 px-2 focus:outline-none ${!isEditMode ? 'pointer-events-none' : ''}`} placeholder="Esperienza..." />
                    <div className="flex items-center border-l border-[#525252] pl-2">
                        {isEditMode && <div onClick={() => exp.mod > -10 && update('mod', exp.mod - 1)} className="stat-arrow text-xs cursor-pointer px-1">▼</div>}
                        <div className={`text-sm font-bold w-6 text-center ${exp.mod === 0 ? 'text-gray-600' : 'text-[#ca8a04]'}`}>{exp.mod > 0 ? '+'+exp.mod : exp.mod}</div>
                        {isEditMode && <div onClick={() => exp.mod < 10 && update('mod', exp.mod + 1)} className="stat-arrow text-xs cursor-pointer px-1">▲</div>}
                    </div>
                    <div className="flex items-center border-l border-[#525252] pl-2 ml-1">
                        <span className="text-[8px] text-yellow-600 uppercase mr-1">Costo</span>
                        {isEditMode && <div onClick={() => exp.cost > 1 && update('cost', exp.cost - 1)} className="stat-arrow text-xs cursor-pointer px-1">▼</div>}
                        <div className="text-xs font-bold text-yellow-500 w-4 text-center">{exp.cost || 1}</div>
                        {isEditMode && <div onClick={() => exp.cost < 5 && update('cost', exp.cost + 1)} className="stat-arrow text-xs cursor-pointer px-1">▲</div>}
                        {!isEditMode && <span className="text-[8px] text-yellow-600 ml-1">SP</span>}
                    </div>
                </div>
            );
        };

        const LevelUpModal = ({ isOpen, onClose, currentLevel, onConfirm }) => {
            if (!isOpen) return null;
            return (
                <div className="modal-overlay" onClick={onClose}>
                    <div className="bg-[#18181b] border border-[#ca8a04] w-full max-w-sm rounded-lg p-5 shadow-2xl text-center" onClick={e => e.stopPropagation()}>
                        <h2 className="font-cinzel text-xl text-[#ca8a04] mb-4">Avanzamento di Livello</h2>
                        <p className="text-white mb-6">Passare al livello <span className="font-bold text-xl">{currentLevel + 1}</span>?</p>
                        <div className="flex gap-4 justify-center">
                            <button onClick={onClose} className="px-4 py-2 border border-gray-600 text-gray-400 rounded hover:text-white">Annulla</button>
                            <button onClick={onConfirm} className="px-4 py-2 bg-[#ca8a04] text-black font-bold rounded hover:bg-[#a16207]">Conferma</button>
                        </div>
                    </div>
                </div>
            );
        };

        const ResultModal = ({ isOpen, onClose, total, detail, title }) => {
            if (!isOpen) return null;
            return (
                 <div className="modal-overlay" onClick={onClose}>
                    <div className="bg-[#18181b] border border-red-900 w-full max-w-sm rounded-lg p-5 text-center shadow-2xl" onClick={e => e.stopPropagation()}>
                        <h2 className="font-cinzel text-xl text-white mb-1">{title}</h2>
                        <div className="text-6xl font-cinzel text-white my-4">{total}</div>
                        <div className="text-xs text-gray-400 mb-4 font-mono">{detail}</div>
                        <button onClick={onClose} className="w-full py-2 bg-gray-800 rounded text-gray-300">Chiudi</button>
                    </div>
                </div>
            );
        };

        const ShortRestModal = ({ isOpen, onClose, rank, onConfirm }) => {
            const [step, setStep] = useState('type-selection'); 
            const [restType, setRestType] = useState(null); 
            const [selections, setSelections] = useState([]);
            const [prepareWithAllies, setPrepareWithAllies] = useState(false);
            const [results, setResults] = useState(null);

            useEffect(() => {
                if (isOpen) {
                    setStep('type-selection');
                    setRestType(null);
                    setSelections([]);
                    setPrepareWithAllies(false);
                    setResults(null);
                }
            }, [isOpen]);

            if (!isOpen) return null;

            const addSelection = (action) => {
                if (selections.length < 2) {
                    setSelections([...selections, action]);
                }
            };

            const removeSelection = (index) => {
                const newSel = [...selections];
                newSel.splice(index, 1);
                setSelections(newSel);
            };

            const handleConfirm = () => {
                const rolledResults = selections.map(action => {
                    if (action === 'prepare') {
                        return { action, value: prepareWithAllies ? 2 : 1, text: "Preparazione" };
                    }
                    const roll = Math.floor(Math.random() * 4) + 1;
                    const total = roll + rank;
                    let text = "";
                    if (action === 'hp') text = "Punti Ferita";
                    if (action === 'stress') text = "Stress";
                    if (action === 'armor') text = "Armatura";
                    
                    return { action, value: total, roll, rank, text };
                });
                
                setResults(rolledResults);
                setStep('results');
                
                if (restType === 'personal') {
                     onConfirm(rolledResults);
                }
            };

            const OPTIONS_PERSONAL = [
                { id: 'hp', label: `Recupera Punti Ferita (1d4 + ${rank})` },
                { id: 'stress', label: `Recupera Stress (1d4 + ${rank})` },
                { id: 'armor', label: `Ripara Armatura (1d4 + ${rank})` },
                { id: 'prepare', label: `Prepararsi (Guadagna Speranza)` }
            ];

            const OPTIONS_ALLY = [
                { id: 'hp', label: `Cura Punti Ferita Alleato (1d4 + ${rank})` },
                { id: 'armor', label: `Ripara Armatura Alleato (1d4 + ${rank})` }
            ];
            
            const currentOptions = restType === 'personal' ? OPTIONS_PERSONAL : OPTIONS_ALLY;

            return (
                <div className="modal-overlay" onClick={onClose}>
                    <div className="bg-[#18181b] border border-[#ca8a04] w-full max-w-sm rounded-lg p-5 shadow-2xl" onClick={e => e.stopPropagation()}>
                        <h2 className="font-cinzel text-xl text-[#ca8a04] mb-4 text-center">Riposo Breve</h2>
                        
                        {step === 'type-selection' && (
                            <div className="flex flex-col gap-3">
                                <button onClick={() => { setRestType('personal'); setStep('action-selection'); }} className="short-rest-btn hover:border-[#ca8a04] text-white">Riposo Personale</button>
                                <button onClick={() => { setRestType('ally'); setStep('action-selection'); }} className="short-rest-btn hover:border-[#ca8a04] text-white">Aiuta un Alleato</button>
                            </div>
                        )}

                        {step === 'action-selection' && (
                            <div className="flex flex-col gap-3">
                                <div className="text-sm text-gray-400 text-center mb-2">Scegli 2 azioni da eseguire:</div>
                                
                                <div className="grid grid-cols-2 gap-2 mb-2">
                                    <div className="border border-gray-600 rounded p-2 text-center min-h-[40px] flex items-center justify-center cursor-pointer hover:bg-red-900/20" onClick={() => selections[0] && removeSelection(0)}>
                                        {selections[0] ? currentOptions.find(o => o.id === selections[0]).label.split('(')[0] : <span className="text-gray-600">Slot 1</span>}
                                    </div>
                                    <div className="border border-gray-600 rounded p-2 text-center min-h-[40px] flex items-center justify-center cursor-pointer hover:bg-red-900/20" onClick={() => selections[1] && removeSelection(1)}>
                                        {selections[1] ? currentOptions.find(o => o.id === selections[1]).label.split('(')[0] : <span className="text-gray-600">Slot 2</span>}
                                    </div>
                                </div>

                                <div className="space-y-1">
                                    {currentOptions.map(opt => (
                                        <button key={opt.id} onClick={() => addSelection(opt.id)} disabled={selections.length >= 2} className={`w-full text-left text-xs p-2 rounded border border-[#3f3f46] ${selections.length >= 2 ? 'opacity-50' : 'hover:bg-[#27272a] hover:border-gray-500'} text-gray-300`}>
                                            {opt.label}
                                        </button>
                                    ))}
                                </div>

                                {restType === 'personal' && selections.includes('prepare') && (
                                    <div className="flex items-center justify-between bg-[#27272a] p-2 rounded border border-blue-900">
                                        <span className="text-xs text-blue-300">Prepararsi con alleati?</span>
                                        <button onClick={() => setPrepareWithAllies(!prepareWithAllies)} className={`w-10 h-6 rounded-full relative transition-colors ${prepareWithAllies ? 'bg-blue-600' : 'bg-gray-600'}`}>
                                            <div className={`absolute top-1 left-1 bg-white w-4 h-4 rounded-full transition-transform ${prepareWithAllies ? 'translate-x-4' : ''}`}></div>
                                        </button>
                                    </div>
                                )}

                                <button onClick={handleConfirm} disabled={selections.length !== 2} className={`w-full py-2 mt-2 font-bold uppercase rounded ${selections.length === 2 ? 'bg-[#ca8a04] text-black' : 'bg-gray-700 text-gray-500 cursor-not-allowed'}`}>
                                    Conferma
                                </button>
                            </div>
                        )}

                        {step === 'results' && (
                            <div className="text-center">
                                <h3 className="text-white font-bold mb-3">{restType === 'personal' ? 'Risultati Applicati' : 'Risultati da Comunicare'}</h3>
                                <div className="space-y-3 mb-4">
                                    {results.map((res, i) => {
                                        let colorClass = "text-white";
                                        let sign = "-"; 
                                        if (res.action === 'hp') colorClass = "text-red-500";
                                        if (res.action === 'stress') colorClass = "text-purple-500";
                                        if (res.action === 'armor') colorClass = "text-blue-400";
                                        if (res.action === 'prepare') {
                                            colorClass = "text-yellow-400";
                                            sign = "+";
                                        }

                                        return (
                                            <div key={i} className="bg-[#27272a] p-3 rounded border border-[#3f3f46] flex flex-col items-center">
                                                <div className="text-xs text-gray-400 uppercase font-bold mb-1">{res.text}</div>
                                                
                                                <div className={`text-4xl font-cinzel font-bold ${colorClass}`}>
                                                    {sign}{res.value}
                                                </div>
                                                
                                                <div className="text-[10px] text-gray-500 mt-1">
                                                    {res.action === 'prepare' 
                                                        ? (res.value === 2 ? "(Con Alleati)" : "(Standard)")
                                                        : `(1d4: ${res.roll} + Rango: ${res.rank})`
                                                    }
                                                </div>
                                            </div>
                                        );
                                    })}
                                </div>
                                <button onClick={onClose} className="text-gray-500 text-xs underline">Chiudi</button>
                            </div>
                        )}
                    </div>
                </div>
            );
        };

        const DiceModal = ({ isOpen, onClose, trait, mod, experiences, currentHope, onRoll }) => {
            const [selectedExps, setSelectedExps] = useState([]);
            const [rollResult, setRollResult] = useState(null);
            const [rollMode, setRollMode] = useState('normal'); 
            const [extraBonus, setExtraBonus] = useState(0);
            const [isRolling, setIsRolling] = useState(false);
            const [animDice, setAnimDice] = useState({ d1: 1, d2: 1 });

            useEffect(() => {
                if (isOpen) {
                    setSelectedExps([]);
                    setRollResult(null);
                    setRollMode('normal');
                    setExtraBonus(0);
                    setIsRolling(false);
                }
            }, [isOpen]);

            if (!isOpen) return null;

            const toggleExp = (index) => {
                if (selectedExps.includes(index)) {
                    setSelectedExps(selectedExps.filter(i => i !== index));
                } else {
                    const exp = experiences[index];
                    const currentCost = selectedExps.reduce((acc, i) => acc + (experiences[i].cost || 1), 0);
                    if (currentCost + (exp.cost || 1) <= currentHope) {
                        setSelectedExps([...selectedExps, index]);
                    }
                }
            };

            const calculateTotalCost = () => selectedExps.reduce((acc, i) => acc + (experiences[i].cost || 1), 0);
            const calculateTotalBonus = () => selectedExps.reduce((acc, i) => acc + (experiences[i].mod || 0), 0);

            const handleRoll = () => {
                setIsRolling(true);
                const animInterval = setInterval(() => {
                    setAnimDice({
                        d1: Math.floor(Math.random() * 12) + 1,
                        d2: Math.floor(Math.random() * 12) + 1
                    });
                }, 80);

                setTimeout(() => {
                    clearInterval(animInterval);
                    const d1 = Math.floor(Math.random() * 12) + 1;
                    const d2 = Math.floor(Math.random() * 12) + 1;
                    const d6 = Math.floor(Math.random() * 6) + 1;
                    
                    const bonus = calculateTotalBonus();
                    let modeVal = 0;
                    if (rollMode === 'adv') modeVal = d6;
                    if (rollMode === 'dis') modeVal = -d6;

                    const total = d1 + d2 + mod + bonus + modeVal + extraBonus;
                    const cost = calculateTotalCost();
                    
                    const isCrit = d1 === d2;
                    const isHope = d1 > d2;
                    
                    setRollResult({ d1, d2, d6, total, cost, rollMode, extraBonus, isCrit });
                    setIsRolling(false);
                    
                    // Passing more info to parent for auto-updates
                    if (onRoll) onRoll({ 
                        cost, 
                        isHope, 
                        isCrit,
                        d1,
                        d2
                    });
                }, 1000); 
            };

            const totalCost = calculateTotalCost();

            return (
                <div className="modal-overlay" onClick={onClose}>
                    <div className="bg-[#18181b] border border-[#ca8a04] w-full max-w-sm rounded-lg p-5 shadow-2xl" onClick={e => e.stopPropagation()}>
                        <h2 className="font-cinzel text-xl text-[#ca8a04] mb-4 text-center">Tiro {trait}</h2>
                        
                        {!rollResult && !isRolling ? (
                            <>
                                <div className="flex mb-4 bg-[#27272a] rounded p-1">
                                    <div onClick={() => setRollMode('dis')} className={`mode-btn ${rollMode === 'dis' ? 'active-dis' : 'text-gray-400 hover:bg-[#3f3f46]'}`}>Svantaggio (-1d6)</div>
                                    <div onClick={() => setRollMode('normal')} className={`mode-btn ${rollMode === 'normal' ? 'active-normal' : 'text-gray-400 hover:bg-[#3f3f46]'}`}>Normale</div>
                                    <div onClick={() => setRollMode('adv')} className={`mode-btn ${rollMode === 'adv' ? 'active-adv' : 'text-gray-400 hover:bg-[#3f3f46]'}`}>Vantaggio (+1d6)</div>
                                </div>

                                <div className="text-center text-gray-400 text-sm mb-4">Modificatore Base: <b className="text-white">{mod > 0 ? '+'+mod : mod}</b></div>

                                <div className="mb-4">
                                    <div className="flex justify-between text-xs text-gray-500 uppercase mb-2 font-bold border-b border-gray-700 pb-1">
                                        <span>Esperienze Utilizzabili</span>
                                        <span className={totalCost > 0 ? "text-yellow-500" : ""}>Costo: {totalCost} / {currentHope} SP</span>
                                    </div>
                                    <div className="space-y-2 max-h-40 overflow-y-auto">
                                        {experiences.filter(e => e.text).map((exp, i) => {
                                            const isSelected = selectedExps.includes(i);
                                            const cost = exp.cost || 1;
                                            const canAfford = isSelected || (totalCost + cost <= currentHope);
                                            
                                            return (
                                                <div key={i} onClick={() => canAfford && toggleExp(i)} 
                                                     className={`flex justify-between items-center p-2 rounded border cursor-pointer transition-colors ${isSelected ? 'bg-[#ca8a04] border-[#ca8a04] text-black' : (canAfford ? 'bg-[#27272a] border-[#3f3f46] text-gray-300 hover:border-gray-500' : 'bg-[#27272a] border-[#3f3f46] text-gray-600 opacity-50 cursor-not-allowed')}`}>
                                                    <span className="text-sm font-bold truncate flex-1">{exp.text}</span>
                                                    <div className="flex items-center gap-3">
                                                        <span className="font-bold">{exp.mod > 0 ? '+'+exp.mod : exp.mod}</span>
                                                        <span className="text-[10px] font-bold border border-current px-1 rounded">{cost} SP</span>
                                                    </div>
                                                </div>
                                            );
                                        })}
                                        {experiences.filter(e => e.text).length === 0 && <div className="text-center text-gray-600 italic text-xs">Nessuna esperienza definita</div>}
                                    </div>
                                </div>

                                <div className="flex items-center justify-center gap-4 mb-4 bg-[#27272a] p-2 rounded">
                                    <span className="text-xs uppercase text-gray-400 font-bold">Extra Bonus</span>
                                    <div className="flex items-center gap-2">
                                        <button onClick={() => extraBonus > -1 && setExtraBonus(extraBonus - 1)} className="w-8 h-8 flex items-center justify-center bg-[#3f3f46] rounded text-white font-bold hover:bg-[#52525b]">-</button>
                                        <span className={`w-8 text-center font-bold ${extraBonus !== 0 ? 'text-[#ca8a04]' : 'text-gray-500'}`}>{extraBonus > 0 ? '+'+extraBonus : extraBonus}</span>
                                        <button onClick={() => extraBonus < 10 && setExtraBonus(extraBonus + 1)} className="w-8 h-8 flex items-center justify-center bg-[#3f3f46] rounded text-white font-bold hover:bg-[#52525b]">+</button>
                                    </div>
                                </div>

                                <button onClick={handleRoll} className="w-full py-3 bg-[#ca8a04] hover:bg-[#a16207] text-black font-bold rounded text-lg uppercase tracking-wide shadow-lg">Lancia Dadi</button>
                            </>
                        ) : (
                            <div className="text-center py-4">
                                <div className="flex justify-center gap-6 mb-6">
                                    <div className="flex flex-col items-center">
                                        <span className="text-[10px] text-gray-500 uppercase mb-1">Speranza</span>
                                        <div className="die-box die-hope">
                                            {isRolling ? animDice.d1 : rollResult.d1}
                                        </div>
                                    </div>
                                    <div className="flex flex-col items-center">
                                        <span className="text-[10px] text-gray-500 uppercase mb-1">Paura</span>
                                        <div className="die-box die-fear">
                                            {isRolling ? animDice.d2 : rollResult.d2}
                                        </div>
                                    </div>
                                </div>
                                
                                {!isRolling && (
                                    <>
                                        {rollResult.rollMode !== 'normal' && (
                                            <div className={`text-sm font-bold mb-2 ${rollResult.rollMode === 'adv' ? 'text-green-400' : 'text-red-400'}`}>
                                                {rollResult.rollMode === 'adv' ? 'Vantaggio' : 'Svantaggio'}: {rollResult.rollMode === 'adv' ? '+' : '-'}{rollResult.d6} (d6)
                                            </div>
                                        )}

                                        <div className="text-sm text-gray-400 mb-4">
                                            {rollResult.d1 + rollResult.d2} (2d12) + {mod} (Stat) + {calculateTotalBonus()} (Exp) 
                                            {rollResult.extraBonus !== 0 && <span> {rollResult.extraBonus > 0 ? '+ ' + rollResult.extraBonus : '- ' + Math.abs(rollResult.extraBonus)} (Extra)</span>}
                                        </div>
                                        
                                        <div className="text-6xl font-cinzel text-[#ca8a04] dice-result mb-4">{rollResult.total}</div>
                                        
                                        <div className="flex justify-center">
                                            {rollResult.d1 === rollResult.d2 ? (
                                                <div className="result-box-large bg-[#ca8a04] text-black border-white shadow-[0_0_20px_rgba(202,138,4,0.6)]">
                                                    CRITICO
                                                </div>
                                            ) : rollResult.d1 > rollResult.d2 ? (
                                                <div className="result-box-large bg-white text-black border-gray-300">
                                                    CON SPERANZA
                                                </div>
                                            ) : (
                                                <div className="result-box-large bg-black text-white border-gray-600">
                                                    CON PAURA
                                                </div>
                                            )}
                                        </div>

                                        {rollResult.cost > 0 && <div className="text-xs text-red-400 mt-2 font-bold">- {rollResult.cost} Speranza</div>}
                                    </>
                                )}
                            </div>
                        )}
                        {!isRolling && <button onClick={onClose} className="mt-4 text-gray-500 text-xs underline w-full text-center">Chiudi</button>}
                    </div>
                </div>
            );
        };

        const ActiveArmorPanel = ({ armor, onUpdateArmor, isEditMode, slots, onUpdateSlots }) => {
            const [isOpen, setIsOpen] = useState(false);
            
            // Safety check for slots prop
            const safeSlots = slots || { current: 0, max: 0 };
            
            return (
                <div className="dh-panel border-l-4 border-l-blue-600 bg-[#1e1e1e] relative pt-2"> 
                    <div className="mb-4">
                        <div className="flex justify-between mb-1">
                             <span className={`text-xs uppercase font-bold ${isEditMode ? 'text-white' : 'text-blue-400'}`}>Slot Armatura</span>
                             {isEditMode && <input type="number" value={safeSlots.max} onChange={e=>onUpdateSlots('max', parseInt(e.target.value))} className="bg-transparent text-right text-xs w-10 text-gray-600 focus:outline-none"/>}
                        </div>
                        <PipTracker total={Math.min(12, safeSlots.max)} current={safeSlots.current} onChange={v => onUpdateSlots('current', v)} type="armor" />
                    </div>
                    <hr className="border-[#3f3f46] mb-2" />
                     <div className="flex items-center justify-between relative mb-2 w-full cursor-pointer" onClick={() => setIsOpen(!isOpen)}>
                        <div className="w-6 text-gray-500 text-xs text-center">{isOpen ? '▼' : '▶'}</div>
                        <label className={`uppercase font-bold text-center text-xs font-bold uppercase tracking-wider font-cinzel cursor-pointer ${isEditMode ? 'text-white' : 'text-[#ca8a04]'}`}>
                            ARMATURA ATTIVA
                        </label>
                        <div className="w-6"></div>
                    </div>

                    {isOpen && (
                        isEditMode ? (
                            <>
                                <div className="mb-3">
                                    <textarea value={armor.name} onChange={e => onUpdateArmor('name', e.target.value)} className="dh-input font-bold w-full text-lg resize-none h-10 text-center" placeholder="Nome Armatura" />
                                </div>
                                <div className="grid grid-cols-2 gap-2 mb-3">
                                    <div><label className="text-[9px] text-gray-500 uppercase font-bold block mb-1 text-center">PUNTI BASE</label><select value={armor.baseScore} onChange={e => onUpdateArmor('baseScore', parseInt(e.target.value))} className="dh-input text-sm py-1 w-full appearance-none text-center">{[...Array(15)].map((_, i) => <option key={i} value={i}>{i}</option>)}</select></div>
                                    <div><label className="text-[9px] text-gray-500 uppercase font-bold block mb-1 text-center">SOGLIE BASE</label><input value={armor.baseThresholds} onChange={e => onUpdateArmor('baseThresholds', e.target.value)} className="dh-input text-sm py-1 w-full text-center" placeholder="es. 5 / 10 / 15" /></div>
                                </div>
                                <div className="mb-3"><label className="text-[9px] text-gray-500 uppercase font-bold block mb-1 text-center">CARATTERISTICHE</label><input value={armor.traits} onChange={e => onUpdateArmor('traits', e.target.value)} className="dh-input text-sm py-1 w-full text-center" placeholder="Caratteristiche armatura" /></div>
                                <div><label className="text-[9px] text-gray-500 uppercase font-bold block mb-1 text-center">PECULIARITÀ</label><textarea value={armor.feature} onChange={e => onUpdateArmor('feature', e.target.value)} className="dh-input text-xs h-16 w-full" placeholder="Descrivi peculiarità..." /></div>
                            </>
                        ) : (
                            <>
                                <div className="text-center mb-4">
                                    <div className="text-white font-bold text-xl font-cinzel mb-1 leading-tight">{armor.name || "Nessuna Armatura"}</div>
                                    <div className="flex justify-center gap-4 text-xs text-gray-400 font-bold uppercase tracking-widest mt-2">
                                        <span>Punti: <span className="text-white text-sm">{armor.baseScore}</span></span>
                                        <span className="text-blue-500">•</span>
                                        <span>Soglie: <span className="text-white text-sm text-white-override">{armor.baseThresholds}</span></span>
                                    </div>
                                </div>
                                <div className="text-center text-xs text-white mb-3 italic text-white-override">{armor.traits || "-"}</div>
                                <div className="text-xs text-gray-400 text-center font-mono bg-[#121212] p-2 rounded border border-[#3f3f46]">{armor.feature || "Nessuna peculiarità"}</div>
                            </>
                        )
                    )}
                </div>
            );
        };

        const InventoryPanel = ({ inventory, onUpdate, isEditMode, potions, onUpdatePotions, onUsePotion }) => {
            const [isOpen, setIsOpen] = useState(false);
            const [isPotionsOpen, setIsPotionsOpen] = useState(false);
            const [resultModal, setResultModal] = useState({ open: false, total: 0, detail: '', title: '' });

            const addPotion = () => { onUpdatePotions([...potions, { id: Date.now(), name: "", count: 1, die: "d4", type: "hp" }]); };
            const removePotion = (id) => { onUpdatePotions(potions.filter(p => p.id !== id)); };
            const updatePotion = (id, newPotion) => { onUpdatePotions(potions.map(p => p.id === id ? newPotion : p)); };
            const handleUsePotion = (p) => {
                 let total = 0;
                 let rolls = [];
                 for(let i=0; i<p.count; i++) {
                     let r = Math.floor(Math.random() * parseInt(p.die.slice(1))) + 1;
                     total += r;
                     rolls.push(r);
                 }
                 onUsePotion(p.type, total);
                 setResultModal({ open: true, title: p.name || 'Pozione', total: total, detail: `${p.count}${p.die} (${rolls.join('+')}) -> ${POTION_TYPES.find(t=>t.id===p.type)?.label}` });
            };

            return (
                <div className="dh-panel border-l-4 border-l-gray-600 bg-[#1e1e1e]">
                    <div className="flex justify-between items-center mb-2 cursor-pointer" onClick={() => setIsOpen(!isOpen)}>
                        <h3 className={`font-cinzel text-sm uppercase flex items-center gap-2 ${isEditMode ? 'text-white' : 'text-[#ca8a04]'}`}>{isOpen ? '▼' : '▶'} Inventario</h3>
                    </div>
                    {isOpen && (
                        <div className="space-y-4">
                            <div>{isEditMode ? <textarea value={inventory} onChange={e => onUpdate(e.target.value)} className="dh-input h-32 text-sm" placeholder="Zaino..." /> : <div className="text-sm text-gray-300 whitespace-pre-wrap">{inventory || "Zaino vuoto."}</div>}</div>
                            <div className="border-t border-[#3f3f46] pt-2">
                                <div className="flex justify-between items-center mb-2 cursor-pointer" onClick={() => setIsPotionsOpen(!isPotionsOpen)}>
                                    <h4 className={`font-cinzel text-xs uppercase flex items-center gap-2 ${isEditMode ? 'text-white' : 'text-purple-400'}`}>{isPotionsOpen ? '▼' : '▶'} Pozioni</h4>
                                </div>
                                {isPotionsOpen && (
                                    <div className="space-y-2">
