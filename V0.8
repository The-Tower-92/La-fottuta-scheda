            if (collapsible && !isExpanded) {
                return (
                    <div className="bg-[#18181b] border border-[#3f3f46] rounded p-2 mb-2 cursor-pointer hover:border-[#ca8a04] transition-colors" onClick={() => setIsExpanded(true)}>
