        const WeaponCard = ({ weapon, onChange, isEditMode, onEquip, label, onRollAttack, onRollDamage, collapsible, onUnequip, isCrit, globalEditMode }) => {
            const update = (f, v) => onChange({...weapon, [f]: v});
            const updateRow = (i, f, v) => { const rows = [...weapon.damageRows]; rows[i][f] = v; update('damageRows', rows); };
            const addRow = () => update('damageRows', [...weapon.damageRows, { count: 1, die: "d6", mod: 0, mod2: 0, type: "fis" }]);
            const removeRow = (idx) => update('damageRows', weapon.damageRows.filter((_, i) => i !== idx));
            const [isExpanded, setIsExpanded] = useState(false);
            const damageLabel = useMemo(() => {
                let diceMap = {}; let totalMod = 0;
                weapon.damageRows.forEach(r => { if(!diceMap[r.die]) diceMap[r.die] = 0; diceMap[r.die] += (r.count || 0); totalMod += (r.mod || 0) + (r.mod2 || 0); });
                let parts = []; DICE.forEach(d => { if(diceMap[d] > 0) parts.push(`${diceMap[d]}${d}`); });
                let modStr = ""; if(totalMod > 0) modStr = `+${totalMod}`; else if(totalMod < 0) modStr = `${totalMod}`;
                return `${parts.join('+')}${modStr}`;
            }, [weapon.damageRows]);
            
            const isActuallyEditing = globalEditMode !== undefined ? globalEditMode : isEditMode;

            // Logic for the forge button color:
